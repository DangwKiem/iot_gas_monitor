generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  operator
  viewer
}

enum SourceKind {
  physical
  simulator
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(viewer)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  sourceKind   SourceKind         @map("source_kind")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime?          @map("last_seen_at") @db.Timestamptz(3)
  latestId     BigInt?            @map("latest_id")
  bootId       String?            @map("boot_id") @db.Uuid
  bootCounter  BigInt?            @map("boot_counter")
  latestSeq    BigInt?            @map("latest_seq")
  readings     SensorReading[]
  credentials  DeviceCredential[]

  @@map("devices")
}

model DeviceCredential {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  keyId      String    @unique @map("key_id")
  secretHash String    @map("secret_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  device     Device    @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@map("device_credentials")
}

model SensorReading {
  id           BigInt    @id @default(autoincrement())
  deviceId     String    @map("device_id") @db.Uuid
  bootId       String    @map("boot_id") @db.Uuid
  bootCounter  BigInt    @map("boot_counter")
  seq          BigInt
  sampledAt    DateTime? @map("sampled_at") @db.Timestamptz(3)
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  temperatureC Float?    @map("temperature_c") @db.Real
  humidityPct  Float?    @map("humidity_pct") @db.Real
  mq2Adc       Int?      @map("mq2_adc")
  mq7Adc       Int?      @map("mq7_adc")
  flame        Boolean?
  payload      Json
  payloadHash  String    @map("payload_hash")
  device       Device    @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, bootId, seq])
  @@index([deviceId, sampledAt(sort: Desc), id(sort: Desc)])
  @@index([deviceId, receivedAt(sort: Desc), id(sort: Desc)])
  @@map("sensor_readings")
}
