# Chỉ dùng local. Tự chọn password; không commit .env.
POSTGRES_USER=iot
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=iot_monitor
DATABASE_URL=postgresql://iot:replace-with-local-database-password@127.0.0.1:15432/iot_monitor?schema=public
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Bootstrap admin: điền email/password của bạn, rồi chạy npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Copy ID/key từ trang Thiết bị để chạy simulator. Không cần cloud.
SIM_DEVICE_ID=
SIM_DEVICE_KEY=
SIM_API_URL=http://127.0.0.1:4000
SIM_INTERVAL_MS=5000
