# Chỉ dùng local. Tự chọn password; không commit .env.
POSTGRES_USER=iot
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=iot_monitor
DATABASE_URL=postgresql://iot:replace-with-local-database-password@127.0.0.1:15432/iot_monitor?schema=public
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Bootstrap admin: điền email/password của bạn, rồi chạy npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Copy ID/key từ trang Thiết bị để chạy simulator. Không cần cloud.
SIM_DEVICE_ID=
SIM_DEVICE_KEY=
SIM_API_URL=http://127.0.0.1:4000
SIM_INTERVAL_MS=5000
# Backup local: dùng passphrase riêng tối thiểu 20 ký tự; lưu riêng khỏi file backup.
# Có thể đặt biến môi trường của terminal thay vì lưu trong .env.
BACKUP_PASSPHRASE=
# Chỉ dùng database trống, riêng biệt để restore drill. Không dùng DATABASE_URL nguồn.
RESTORE_DATABASE_URL=
# Telegram: mặc định tắt; không commit token/chat ID. Bot token lấy từ @BotFather.
TELEGRAM_ENABLED=false
# Menu tương tác qua long polling, độc lập với thông báo một chiều.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chỉ bật true khi muốn nhận cả cảnh báo giả lập từ simulator.
TELEGRAM_INCLUDE_SIMULATORS=false
# Web Push: tạo cặp khóa bằng npm run webpush:keys; chỉ lưu private key ở backend.
# Không commit khóa hoặc dùng prefix VITE_ cho private key.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
